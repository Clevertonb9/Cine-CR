rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function allowedDataDocument(documentId) {
      return documentId.matches('^(favoritos|assistidos|quero_ver|historico|perfil)$')
        // Formato legado da V3, mantido para leitura dos dados já existentes.
        || documentId.matches('^(favoritos|assistidos|quero_ver|historico)__[A-Za-z0-9_-]+_[0-9]{3}$')
        // Blocos versionados da V4: <doc>__g_<geração>__<campo>_<índice>.
        || documentId.matches('^(favoritos__g_[a-f0-9]{24}__items_[0-9]{3})$')
        || documentId.matches('^(assistidos__g_[a-f0-9]{24}__(movies|episodes|movieMeta|seriesMeta)_[0-9]{3})$')
        || documentId.matches('^(quero_ver__g_[a-f0-9]{24}__items_[0-9]{3})$')
        || documentId.matches('^(historico__g_[a-f0-9]{24}__(filmes|series)_[0-9]{3})$');
    }

    match /users/{userId}/data/{documentId} {
      allow read, write: if signedInAs(userId) && allowedDataDocument(documentId);
    }

    // Avaliações públicas por título: leitura para usuários autenticados; cada pessoa só altera a própria avaliação.
    match /publicReviews/{mediaKey}/reviews/{userId} {
      allow read: if request.auth != null;
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['uid','displayName','rating','text','updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500;
      allow delete: if signedInAs(userId);
    }

    // Pontuação do quiz: ranking legível por usuários autenticados; cada usuário só grava o próprio placar.
    match /quizScores/{userId} {
      allow read: if request.auth != null;
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['uid','displayName','bestScore','gamesPlayed','updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 10
        && request.resource.data.gamesPlayed is int
        && request.resource.data.gamesPlayed >= 1;
      allow delete: if signedInAs(userId);
    }

    // Bloqueia qualquer outro documento/caminho não autorizado acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
